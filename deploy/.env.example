# Public address of this host (what clients put into "ID server").
RUCONNECT_ID_SERVER=rustdesk.example.com
# Optional: relay address handed to clients and shown in the panel
# (defaults to the ID server with port 21117).
RUCONNECT_RELAY_SERVER=
# Public API / panel URL shown in the panel, e.g. http://rustdesk.example.com:21114
# (https://rustdesk.example.com with the https profile). Required for OIDC behind a proxy.
RUCONNECT_API_SERVER=

# HTTPS profile (docker compose --profile https up -d): the panel's domain. Caddy also gets
# certificates for organization domains added in the panel.
# With it, also set RUCONNECT_LISTEN=127.0.0.1:21114 and RUCONNECT_TRUST_PROXY=true.
RUCONNECT_DOMAIN=
RUCONNECT_LISTEN=:21114

# First administrator. Leave the password empty to generate one (printed in the log once).
RUCONNECT_ADMIN_USER=admin
RUCONNECT_ADMIN_PASSWORD=

# Access token lifetime in hours (default 30 days).
RUCONNECT_TOKEN_TTL_HOURS=720
# Delete audit records older than N days (0 = keep forever).
RUCONNECT_AUDIT_RETENTION_DAYS=0
# Set to true when running behind a reverse proxy that sets X-Forwarded-For.
RUCONNECT_TRUST_PROXY=false
# info or debug
RUCONNECT_LOG_LEVEL=info

# LDAP / Active Directory login (optional). Users are created on first login.
# Active Directory example: ldaps://dc1.corp.local:636, filter (&(objectClass=user)(sAMAccountName=%s))
RUCONNECT_LDAP_URL=
RUCONNECT_LDAP_BIND_DN=
RUCONNECT_LDAP_BIND_PASSWORD=
RUCONNECT_LDAP_BASE_DN=
RUCONNECT_LDAP_USER_FILTER=
RUCONNECT_LDAP_NAME_ATTR=
# Members of this group become administrators; when empty, admin rights are managed in the panel.
RUCONNECT_LDAP_ADMIN_GROUP=
# When set, only members of this group may log in.
RUCONNECT_LDAP_REQUIRED_GROUP=
RUCONNECT_LDAP_STARTTLS=false
RUCONNECT_LDAP_INSECURE_SKIP_VERIFY=false

# Built-in ID server (hbbs replacement) and relay (hbbr replacement).
# Set RUCONNECT_RENDEZVOUS=false to keep using external hbbs/hbbr; then point
# RUCONNECT_KEY_FILE at their id_ed25519.pub.
RUCONNECT_RENDEZVOUS=true
RUCONNECT_RELAY=true
# Send every session through the relay (useful when clients cannot reach each other).
RUCONNECT_ALWAYS_RELAY=false
# Several relays, comma separated, handed out round robin (default: this host).
RUCONNECT_RELAY_SERVERS=
