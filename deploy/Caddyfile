# TLS front end for RuConnect (docker compose --profile https up -d).
# Clients then use https://<domain> as their API server.
#
# Certificates are issued on first use for RUCONNECT_DOMAIN, the host of
# RUCONNECT_API_SERVER and every organization domain added in the panel;
# RuConnect answers which domains are allowed.
{
	on_demand_tls {
		ask http://127.0.0.1:21114/tls/ask
	}
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:21114
}
